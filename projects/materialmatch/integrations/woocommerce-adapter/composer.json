{
  "name": "materialmatch/woocommerce-adapter",
  "description": "WooCommerce cart and product catalog adapter for MaterialMatch.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "MaterialMatch\\WooCommerce\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MaterialMatch\\WooCommerce\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  }
}
