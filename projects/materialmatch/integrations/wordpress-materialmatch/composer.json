{
  "name": "materialmatch/wordpress-materialmatch",
  "description": "WordPress plugin foundation for MaterialMatch.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "materialmatch/woocommerce-adapter": "0.1.0-dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../woocommerce-adapter",
      "options": {
        "symlink": false,
        "versions": {
          "materialmatch/woocommerce-adapter": "0.1.0-dev"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "MaterialMatch\\WordPress\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MaterialMatch\\WordPress\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  }
}
