{
  "name": "materialmatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first material calculation engine, widget, and commerce integrations.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @materialmatch/demo-store dev",
    "dev:demo": "pnpm --filter @materialmatch/demo-store dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @materialmatch/calculation-engine test",
    "test:e2e": "pnpm --filter @materialmatch/demo-store --filter @materialmatch/materialmatch-widget test:e2e",
    "test:php": "node scripts/run-php-tests/index.mjs",
    "test:wordpress:integration": "node scripts/test-wordpress-integration/index.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:php && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:pack": "tsx scripts/validate-pack/index.ts",
    "create:demo-data": "tsx scripts/create-demo-data/index.ts",
    "build:wordpress-release": "node scripts/build-release/index.mjs",
    "build:demo-release": "node scripts/build-demo-release/index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@materialmatch/configuration-schema": "workspace:*",
    "@materialmatch/domain": "workspace:*",
    "@materialmatch/test-fixtures": "workspace:*",
    "@php-wasm/node": "3.1.45",
    "@php-wasm/universal": "3.1.45",
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.43",
    "@wp-playground/cli": "3.1.45",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
